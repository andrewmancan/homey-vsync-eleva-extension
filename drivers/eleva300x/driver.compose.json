{
  "name": {
    "en": "Eleva 300X (Preview)"
  },
  "class": "airpurifier",
  "capabilities": [
    "onoff",
    "eleva_mode",
    "fanSpeed0to4",
    "measure_pm25",
    "measure_pm1_eleva",
    "measure_pm10_eleva",
    "measure_filter_life",
    "measure_carbon_filter_life_eleva",
    "display_toggle",
    "eleva_child_lock"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "repair": [
    {
      "id": "login",
      "template": "login_credentials",
      "options": {
        "logo": "icon.svg",
        "usernameLabel": {
          "en": "E-mail address",
          "de": "E-Mail adresse"
        },
        "usernamePlaceholder": {
          "en": "john@doe.com",
          "de": "max@mueller.de"
        },
        "passwordLabel": {
          "en": "Password",
          "de": "Passwort"
        },
        "passwordPlaceholder": {
          "en": "Password",
          "de": "Passwort"
        }
      }
    }
  ],
  "pair": [
    {
      "id": "login",
      "template": "login_credentials",
      "options": {
        "logo": "icon.svg",
        "usernameLabel": {
          "en": "E-mail address"
        },
        "usernamePlaceholder": {
          "en": "john@doe.com"
        },
        "passwordLabel": {
          "en": "Password"
        },
        "passwordPlaceholder": {
          "en": "Password"
        }
      }
    },
    {
      "id": "list_my_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_my_devices"
      }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ],
  "capabilitiesOptions": {
    "fanSpeed0to4": {
      "title": {
        "en": "Manual fan level (4 = Turbo)"
      }
    },
    "measure_filter_life": {
      "title": {
        "en": "HEPA filter life"
      }
    }
  }
